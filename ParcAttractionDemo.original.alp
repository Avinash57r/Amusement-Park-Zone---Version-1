					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Guest]]></Type>
					</Parameter>
					<Body><![CDATA[if (randomTrue(foodProbability))
{
	ped.tasks.add(new Task(TaskType.FOOD, 0));
}

Collections.shuffle(ped.tasks, getEngine().getDefaultRandomGenerator());]]></Body>
				</Function>
