			<Name><![CDATA[Main]]></Name>
			<Import><![CDATA[import javax.swing.JOptionPane;
import com.anylogic.engine.markup.*;]]></Import>
			<StartupCode><![CDATA[attractions.clear();

// Exit 1: Roller Coaster
attractions.add(new Attraction("Roller Coaster", AttractionGenre.ROLLER_COASTER, 3.0, 9.0));

// Exit 2: Flat Ride
attractions.add(new Attraction("Flat Ride", AttractionGenre.FLAT_RIDE, 1.0, 6.0));

// Exit 3: Restaurant
attractions.add(new Attraction("Restaurant", AttractionGenre.RESTAURANT, 0.0, 5.0));

// Exit 4: Shop
attractions.add(new Attraction("Shop", AttractionGenre.SHOP, 0.5, 4.0));

// Exit 5: WC
attractions.add(new Attraction("WC", AttractionGenre.WC, 0.0, 2.0));]]></StartupCode>
