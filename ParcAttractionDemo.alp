	<JavaClasses>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1791154393840</Id>
			<Name><![CDATA[Attraction]]></Name>
			<Text><![CDATA[public class Attraction {
    public String name;
    public AttractionGenre genre;
    public double energyCost;
    public double baseAttractiveness; // ex: 1.0 - 10.0 scale

    public Attraction(String name, AttractionGenre genre, double energyCost, double baseAttractiveness) {
        this.name = name;
        this.genre = genre;
        this.energyCost = energyCost;
        this.baseAttractiveness = baseAttractiveness;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1791154432886</Id>
			<Name><![CDATA[AttractionGenre]]></Name>
			<Text><![CDATA[public enum AttractionGenre {
    ROLLER_COASTER,
    FLAT_RIDE,
    RESTAURANT,
    SHOP,
    WC
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1791154448252</Id>
			<Name><![CDATA[Visitor]]></Name>
			<Text><![CDATA[public class Visitor {
    public int id;
    public double rollerCoasterInterest; // Thrill preference (1-10)
    public double flatRideInterest;      // Gentle/family ride preference (1-10)
    public double shopInterest;          // Souvenir/merch preference (1-10)
    public double hunger;                // 0 to 10
    public double personalEnergy;        // 0 to 10 (depletes, WC/Rest restores)

    public Visitor(int id, double coaster, double flatRide, double shop, double hunger, double energy) {
        this.id = id;
        this.rollerCoasterInterest = coaster;
        this.flatRideInterest = flatRide;
        this.shopInterest = shop;
        this.hunger = hunger;
        this.personalEnergy = energy;
    }

    public double calculateIndividualInterest(Attraction attraction) {
        double interest = 0.0;

        switch (attraction.genre) {
            case ROLLER_COASTER:
                interest = this.rollerCoasterInterest;
                break;
            case FLAT_RIDE:
                interest = this.flatRideInterest;
                break;
            case SHOP:
                interest = this.shopInterest;
                break;
            case RESTAURANT:
                interest = this.hunger;
                break;
            case WC:
                // Urgency/need to rest increases as energy drops
                interest = Math.max(0.0, 10.0 - this.personalEnergy);
                break;
        }

        // Energy penalty if exhausted
        if (this.personalEnergy < attraction.energyCost) {
            interest *= 0.2;
        }

        return interest;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1791154461395</Id>
			<Name><![CDATA[VisitorGroup]]></Name>
			<Text><![CDATA[import java.util.ArrayList;
import java.util.List;

public class VisitorGroup {
    public int groupId;
    public List<Visitor> members = new ArrayList<>();

    public VisitorGroup(int groupId) {
        this.groupId = groupId;
    }

    public double calculateGroupInterest(Attraction attraction) {
        if (members == null || members.isEmpty()) return 0.0;

        // 1. Critical Hunger Override -> Go to Restaurant
        boolean anyStarving = false;
        double totalHunger = 0.0;
        int validMemberCount = 0;

        for (Visitor v : members) {
            if (v == null) continue; // Skip any null entry safely
            if (v.hunger >= 8.0) anyStarving = true;
            totalHunger += v.hunger;
            validMemberCount++;
        }

        if (validMemberCount == 0) return 0.0;

        double avgHunger = totalHunger / validMemberCount;

        if (anyStarving || avgHunger >= 6.0) {
            return (attraction.genre == AttractionGenre.RESTAURANT) ? 100.0 : 0.0;
        }

        // 2. Critical Exhaustion Override -> Go to WC / Rest Area
        boolean anyExhausted = false;
        for (Visitor v : members) {
            if (v == null) continue;
            if (v.personalEnergy <= 1.0) {
                anyExhausted = true;
                break;
            }
        }

        if (anyExhausted) {
            return (attraction.genre == AttractionGenre.WC) ? 100.0 : 0.0;
        }

        // 3. Baseline utility floors for maintenance zones when not urgent
        if (attraction.genre == AttractionGenre.RESTAURANT || attraction.genre == AttractionGenre.WC) {
            return 1.0;
        }

        // 4. Democratic Consensus across recreational options
        double sumInterest = 0.0;
        for (Visitor v : members) {
            if (v == null) continue;
            sumInterest += v.calculateIndividualInterest(attraction);
        }

        return sumInterest / validMemberCount;
    }
}]]></Text>
		</JavaClass>
	</JavaClasses>
