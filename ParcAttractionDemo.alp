						<Parameter>
							<Name><![CDATA[onBeginGrouping]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEndGrouping]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[VisitorGroup vg = new VisitorGroup(group.getId());

for (int i = 0; i < group.size(); i++) {
    Guest g = (Guest) group.get(i);
    
    // Safety check: ensure visitorData is not null
    if (g.visitorData == null) {
        g.visitorData = new Visitor(
            g.getIndex(),
            uniform(1.0, 10.0),
            uniform(1.0, 10.0),
            uniform(1.0, 10.0),
            uniform(1.0, 4.0),
            uniform(7.0, 10.0)
        );
    }
    
    vg.members.add(g.visitorData);
    g.visitorGroup = vg;
}]]></Code>
