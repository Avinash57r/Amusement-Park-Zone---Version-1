			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1728549401604</Id>
					<Name><![CDATA[generateTasks]]></Name>
					<X>40</X><Y>1300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Guest]]></Type>
					</Parameter>
					<Body><![CDATA[if (randomTrue(rollerCoasterProbability))
{
	ped.tasks.add(new Task(TaskType.ROLLERCOASTER, 0));
}

if (randomTrue(flatRideProbability))
{
	ped.tasks.add(new Task(TaskType.FLATRIDE, 0));
}

if (randomTrue(shopProbability))
{
	ped.tasks.add(new Task(TaskType.SHOP, 0));
}

if (randomTrue(wcProbability))
{
	ped.tasks.add(new Task(TaskType.WC, 0));
}

if (randomTrue(foodProbability))
{
	ped.tasks.add(new Task(TaskType.FOOD, 0));
}

Collections.shuffle(ped.tasks, getEngine().getDefaultRandomGenerator());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1728680509333</Id>
					<Name><![CDATA[navigate]]></Name>
					<X>420</X><Y>1120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[viewArea]]></Name>
						<Type><![CDATA[ViewArea]]></Type>
					</Parameter>
					<Body><![CDATA[selectedViewArea = viewArea;
viewArea.navigateTo();
groupMainMenu.setPos( viewArea.getX(), viewArea.getY() );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791158042116</Id>
					<Name><![CDATA[getQueueForExit]]></Name>
					<X>60</X><Y>1770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[exitIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[switch (exitIndex) {
    case 1: return (double) rollerCoasterService.queueSize();
    case 2: return (double) flatRideService.queueSize();
    case 3: return (double) restaurantService.queueSize();
    case 4: return (double) shopService.size();
    case 5: return (double) wcService.queueSize();
    default: return 0.0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1791160125784</Id>
					<Name><![CDATA[chooseNextAttraction]]></Name>
					<X>200</X><Y>1770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Guest]]></Type>
					</Parameter>
					<Body><![CDATA[VisitorGroup vg = ped.visitorGroup;

if (vg == null) {
    return uniform_discr(1, 5);
}

double bestUtility = -Double.MAX_VALUE;
int bestExit = 1;
double betaQueue = 0.4;

for (int i = 0; i < attractions.size(); i++) {
    Attraction a = attractions.get(i);
    int exitNum = i + 1;

    double v_gi = vg.calculateGroupInterest(a);
    double currentQueue = getQueueForExit(exitNum);
    double queuePenalty = betaQueue * currentQueue;
    double epsilon = uniform(-0.3, 0.3);

    double u_gi = v_gi - queuePenalty + epsilon;

    if (u_gi > bestUtility) {
        bestUtility = u_gi;
        bestExit = exitNum;
    }
}

return bestExit;]]></Body>
				</Function>
			</Functions>
